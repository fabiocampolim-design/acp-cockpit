[
  {
    "on_method": "initialize",
    "respond": {
      "protocolVersion": 1,
      "agentCapabilities": {}
    }
  },
  {
    "on_method": "session/new",
    "respond": {
      "sessionId": "$SESSION",
      "modes": {
        "currentModeId": "default",
        "availableModes": [
          {
            "id": "default",
            "name": "Default"
          }
        ]
      }
    }
  },
  {
    "on_method": "session/prompt",
    "if_prompt_contains": "PERMISSION",
    "request": [
      {
        "jsonrpc": "2.0",
        "id": 900,
        "method": "session/request_permission",
        "params": {
          "sessionId": "$SESSION",
          "toolCall": {
            "toolCallId": "t1",
            "title": "Write file"
          },
          "options": [
            {
              "optionId": "y",
              "name": "Allow",
              "kind": "allow_once"
            },
            {
              "optionId": "n",
              "name": "Reject",
              "kind": "reject_once"
            }
          ]
        }
      }
    ],
    "respond": {
      "stopReason": "end_turn"
    }
  },
  {
    "on_method": "session/prompt",
    "if_prompt_contains": "ASKQUESTION",
    "request": [
      {
        "jsonrpc": "2.0",
        "id": 901,
        "method": "elicitation/create",
        "params": {
          "mode": "form",
          "sessionId": "$SESSION",
          "toolCallId": "t-ask",
          "message": "Please answer the following questions.",
          "requestedSchema": {
            "type": "object",
            "properties": {
              "question_0": {
                "type": "string",
                "title": "Colour",
                "description": "Which colour?",
                "oneOf": [
                  {
                    "const": "Red",
                    "title": "Red"
                  },
                  {
                    "const": "Blue",
                    "title": "Blue",
                    "description": "the cold one"
                  }
                ]
              },
              "question_0_custom": {
                "type": "string",
                "title": "Other",
                "description": "Type your own answer instead of choosing an option above (optional)."
              },
              "question_1": {
                "type": "array",
                "title": "Extras",
                "description": "Which extras?",
                "items": {
                  "anyOf": [
                    {
                      "const": "Ice",
                      "title": "Ice"
                    },
                    {
                      "const": "Lemon",
                      "title": "Lemon"
                    }
                  ]
                }
              },
              "question_1_custom": {
                "type": "string",
                "title": "Other",
                "description": "Type your own answer instead of choosing an option above (optional)."
              }
            }
          }
        }
      }
    ],
    "respond": {
      "stopReason": "end_turn"
    }
  },
  {
    "on_method": "session/prompt",
    "if_prompt_contains": "LANES",
    "notify": [
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "agent_thought_chunk",
            "content": {
              "type": "text",
              "text": "weighing the options"
            }
          }
        }
      },
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "t-main",
            "title": "Read config.toml",
            "kind": "read",
            "status": "completed"
          }
        }
      },
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "t-task",
            "title": "Task: research the API",
            "kind": "other",
            "status": "in_progress"
          }
        }
      },
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "t-child",
            "title": "Grep in the subagent",
            "kind": "search",
            "status": "completed",
            "_meta": {
              "claudeCode": {
                "parentToolUseId": "t-task"
              }
            }
          }
        }
      },
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "the plain answer"
            }
          }
        }
      }
    ],
    "stderr": [
      "[session/query] diagnostic line"
    ],
    "respond": {
      "stopReason": "end_turn"
    }
  },
  {
    "on_method": "session/prompt",
    "if_prompt_contains": "LIMITS",
    "notify": [
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "usage_update",
            "used": 42000,
            "size": 200000,
            "_meta": {
              "_claude/rateLimit": {
                "status": "allowed",
                "rateLimitType": "five_hour",
                "utilization": 42,
                "resetsAt": 1788000000
              }
            }
          }
        }
      },
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "usage_update",
            "used": 42000,
            "size": 200000,
            "_meta": {
              "_claude/rateLimit": {
                "status": "allowed_warning",
                "rateLimitType": "seven_day",
                "utilization": 88,
                "resetsAt": 1788600000,
                "isUsingOverage": true,
                "canUserPurchaseCredits": true
              }
            }
          }
        }
      }
    ],
    "respond": {
      "stopReason": "end_turn"
    }
  },
  {
    "on_method": "session/prompt",
    "if_prompt_contains": "ANOMALY",
    "notify": [
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "somebody-elses-session",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "not for you"
            }
          }
        }
      }
    ],
    "respond": {
      "stopReason": "end_turn"
    }
  },
  {
    "on_method": "session/prompt",
    "notify": [
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "hello "
            }
          }
        }
      },
      {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "$SESSION",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "world"
            }
          }
        }
      }
    ],
    "respond": {
      "stopReason": "end_turn"
    }
  }
]
