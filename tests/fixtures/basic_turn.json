        "isUsingOverage": true,
        "canUserPurchaseCredits": true,
        "unifiedWindows": {
         "seven_day": {
          "utilization": 0.88,
          "resetsAt": 1788631200
         },
         "seven_day_overage_included": {
          "utilization": 0.45,
          "resetsAt": 1788631200
         }
        }
       }
      }
     }
    }
   }
  ],
  "respond": {
   "stopReason": "end_turn"
  }
 },
 {
  "on_method": "session/prompt",
  "if_prompt_contains": "ANOMALY",
  "notify": [
   {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "somebody-elses-session",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "not for you"
      }
     }
    }
   }
  ],
  "respond": {
   "stopReason": "end_turn"
  }
 },
 {
  "on_method": "session/prompt",
  "if_prompt_contains": "SLOW",
  "delay_ms": 3000,
  "respond": {
   "stopReason": "end_turn"
  }
 },
 {
  "on_method": "session/prompt",
  "if_prompt_contains": "SUGGEST",
  "notify": [
   {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "$SESSION",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "done."
      }
     }
    }
   },
   {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "$SESSION",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": ""
      },
      "_meta": {
       "_claude/promptSuggestion": {
        "type": "prompt_suggestion",
        "suggestion": "add a test for add()"
       }
      }
     }
    }
   }
  ],
  "respond": {
   "stopReason": "end_turn"
  }
 },
 {
  "on_method": "session/prompt",
  "notify": [
   {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "$SESSION",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "hello "
      }
     }
    }
   },
   {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "$SESSION",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "world"
      }
     }
    }
   }
  ],
  "respond": {
   "stopReason": "end_turn"
  }
 }
]
