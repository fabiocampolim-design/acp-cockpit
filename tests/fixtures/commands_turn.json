[
  {"on_method": "initialize",
   "respond": {"protocolVersion": 1, "agentCapabilities": {
     "loadSession": true,
     "sessionCapabilities": {"list": {}, "resume": {}}}}},
  {"on_method": "session/list",
   "respond": {"sessions": [
     {"sessionId": "old-1", "cwd": "/anywhere", "title": "Old work"}]}},
  {"on_method": "session/resume",
   "respond": {"modes": {"currentModeId": "plan",
                          "availableModes": [{"id": "plan", "name": "Plan"}]}}},
  {"on_method": "session/new",
   "notify": [
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "available_commands_update",
                    "availableCommands": [
                      {"name": "context", "description": "Show context usage"},
                      {"name": "compact", "description": "Compact history"}]}}},
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "usage_update",
                    "used": 59300, "size": 1000000,
                    "cost": {"amount": 0.42, "currency": "USD"}}}},
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "session_info_update",
                    "title": "Fixture session"}}},
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "config_option_update",
                    "configOptions": [
                      {"id": "effort", "name": "Effort", "type": "select",
                       "currentValue": "high",
                       "options": [{"value": "low", "name": "Low"},
                                   {"value": "high", "name": "High"}]}]}}}],
   "respond": {"sessionId": "$SESSION",
               "models": {"currentModelId": "default",
                           "availableModels": [
                             {"modelId": "default", "name": "Default",
                              "description": "Opus 4.6 - Most capable"},
                             {"modelId": "sonnet", "name": "Sonnet"}]},
               "modes": {"currentModeId": "default",
                          "availableModes": [{"id": "default",
                                              "name": "Default"}]}}},
  {"on_method": "session/set_model", "respond": {}},
  {"on_method": "session/set_config_option",
   "respond": {"configOptions": [
     {"id": "effort", "name": "Effort", "type": "select",
      "currentValue": "low",
      "options": [{"value": "low", "name": "Low"},
                  {"value": "high", "name": "High"}]}]}},
  {"on_method": "session/prompt", "if_prompt_contains": "DIFF",
   "notify": [
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "tool_call", "toolCallId": "tc-1",
                    "title": "Edit hello.py", "kind": "edit",
                    "status": "pending"}}},
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "tool_call_update", "toolCallId": "tc-1",
                    "status": "completed",
                    "content": [{"type": "diff", "path": "/p/hello.py",
                                 "oldText": "a\nb\nc\n",
                                 "newText": "a\nB\nc\nd\n"}]}}}],
   "respond": {"stopReason": "end_turn"}},
  {"on_method": "session/prompt",
   "delay_ms": 1500,
   "stderr": ["<local-command-stdout>## Context Usage",
              "</local-command-stdout>"],
   "notify": [
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "agent_thought_chunk",
                    "content": {"type": "text", "text": ""}}}},
     {"jsonrpc": "2.0", "method": "session/update",
      "params": {"sessionId": "$SESSION",
        "update": {"sessionUpdate": "agent_message_chunk",
                    "content": {"type": "text", "text": "ran it"}}}}],
   "respond": {"stopReason": "end_turn"}}
]
